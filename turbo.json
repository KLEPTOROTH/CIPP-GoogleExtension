{
  "$schema": "https://turbo.build/schema.json",
  "globalDependencies": ["**/.env", "tsconfig.base.json"],
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "inputs": [
        "src/**",
        "pages/**",
        "public/**",
        "package.json",
        "tsconfig.json",
        "next.config.*",
        "host.json",
        "local.settings.json.example"
      ],
      "outputs": ["dist/**", ".next/**", "!.next/cache/**", "out/**"]
    },
    "lint": {
      "dependsOn": ["^build"],
      "inputs": ["src/**", "pages/**", "*.{ts,tsx,js,jsx,cjs,mjs}", ".eslintrc*", "package.json"],
      "outputs": []
    },
    "typecheck": {
      "dependsOn": ["^build"],
      "inputs": ["src/**", "pages/**", "*.ts", "*.tsx", "tsconfig*.json", "package.json"],
      "outputs": []
    },
    "test": {
      "dependsOn": ["^build"],
      "inputs": ["src/**", "pages/**", "test/**", "tests/**", "package.json", "tsconfig*.json"],
      "outputs": ["coverage/**"]
    }
  }
}
