{
  "name": "cipp-google-extension",
  "version": "0.0.0",
  "private": true,
  "description": "Unified Google Workspace + Microsoft 365 front end for MSPs.",
  "license": "AGPL-3.0-only",
  "engines": {
    "node": ">=20.0.0 <21",
    "pnpm": ">=9"
  },
  "packageManager": "pnpm@9.12.3",
  "scripts": {
    "build": "turbo run build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "prettier": "3.3.3",
    "tsx": "4.19.1",
    "turbo": "2.1.3",
    "typescript": "5.5.4"
  }
}
