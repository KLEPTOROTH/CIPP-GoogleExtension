{
  "name": "@cipp-google/core",
  "version": "0.0.0",
  "private": true,
  "license": "AGPL-3.0-only",
  "description": "Shared core types and utilities for CIPP-GoogleExtension.",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./test-conformance": {
      "types": "./dist/test-conformance/index.d.ts",
      "import": "./dist/test-conformance/index.js",
      "default": "./dist/test-conformance/index.js"
    }
  },
  "files": ["dist"],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "lint": "eslint . --ext .js,.jsx,.ts,.tsx --max-warnings=0",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run --config ../../vitest.config.ts"
  },
  "devDependencies": {
    "@cipp-google/eslint-config": "workspace:*",
    "@typescript-eslint/eslint-plugin": "7.18.0",
    "@typescript-eslint/parser": "7.18.0",
    "eslint": "8.57.1",
    "eslint-config-prettier": "9.1.0",
    "eslint-import-resolver-typescript": "3.6.3",
    "eslint-plugin-import": "2.30.0",
    "typescript": "5.5.4",
    "vitest": "2.1.4"
  }
}
