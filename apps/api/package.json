  },
  "devDependencies": {
    "@cipp-google/eslint-config": "workspace:*",
    "@types/node": "20.16.5",
    "eslint": "8.57.1",
    "eslint-config-prettier": "9.1.0",
    "eslint-plugin-import": "2.30.0",
    "typescript": "5.5.4"
  }
}
