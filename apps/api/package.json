{
  "name": "@cipp-google/api",
  "version": "0.0.0",
  "private": true,
  "license": "AGPL-3.0-only",
  "description": "CIPP-GoogleExtension API (Azure Functions v4, Node 20).",
  "main": "dist/src/functions/*.js",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "func start",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "pnpm run test:node && pnpm run test:vitest",
    "test:node": "tsx --test test/cipp-store-factory.test.ts test/source.test.ts",
    "test:vitest": "vitest run --config ../../vitest.config.ts test/cipp-sync.test.ts test/health.test.ts test/issue-liveness-policy.test.ts test/issue-lifecycle-mutation.test.ts test/issue-lifecycle-durable-cas.test.ts"
  },
  "dependencies": {
    "@azure/data-tables": "13.3.2",
    "@azure/functions": "4.5.1",
    "@cipp-google/adapter-cipp": "workspace:*",
    "@cipp-google/audit": "workspace:*",
    "@cipp-google/core": "workspace:*"
  },
  "devDependencies": {
    "@cipp-google/eslint-config": "workspace:*",
    "@types/node": "20.16.5",
    "eslint": "8.57.1",
    "eslint-config-prettier": "9.1.0",
    "eslint-plugin-import": "2.30.0",
    "typescript": "5.5.4"
  }
}
